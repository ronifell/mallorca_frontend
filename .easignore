# Dependencies and caches (EAS installs fresh on the build server)
node_modules/
.expo/
.expo-shared/

# Keep ios out of the Android build archive.
# android is intentionally uploaded: EAS "Prepare credentials" writes
# android/app/eas-build-inject-android-credentials.gradle and fails with ENOENT
# if only an empty/missing android tree is present (CNG + Windows easignore quirk).
# Run: EAS_BUILD_PROFILE=production npx expo prebuild --clean --platform android
# before production EAS builds so cleartext/plugins match app.config.js.
ios
ios/

# Local secrets and logs
.env
.env.*
*.log

# IDE / OS noise
.idea/
.vscode/
.DS_Store

# Unused duplicate assets (not referenced in src/)
assets/login1.png
assets/onboarding1.png

# Stray backup files
package.json.*

# Do not ship Firebase admin SDK key in the build archive
*firebase-adminsdk*.json
